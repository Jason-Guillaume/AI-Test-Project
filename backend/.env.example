# 数据库连接地址
DATABASE_URL=postgresql+psycopg://<用户名>:<数据库密码>@127.0.0.1:5432/<数据库名>
# 应用签名密钥
SECRET_KEY=
# JWT签名算法
ALGORITHM=HS256
# 访问令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Cookie是否仅通过HTTPS传输
AUTH_COOKIE_SECURE=false
# 允许跨域访问的前端地址
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 数据库连接池基础连接数
DB_POOL_SIZE=10
# 数据库连接池最大溢出数
DB_MAX_OVERFLOW=20
# 等待数据库连接的时长（秒）
DB_POOL_TIMEOUT_SECONDS=30
# 数据库连接回收间隔（秒）
DB_POOL_RECYCLE_SECONDS=1800
# 初始化管理员用户名
INIT_ADMIN_USERNAME=
# 初始化管理员密码
INIT_ADMIN_PASSWORD=
# 启动时是否自动创建数据表
AUTO_CREATE_SCHEMA=false
# 开发环境服务地址
ENV_DEV_URL=http://127.0.0.1:8000
# 测试环境服务地址
ENV_TEST_URL=http://test-api.example.com
# 预发布环境服务地址
ENV_STAGING_URL=http://staging-api.example.com
# 生产环境服务地址
ENV_PROD_URL=
# 是否启用Langfuse追踪
LANGFUSE_ENABLED=false
# Langfuse公钥
LANGFUSE_PUBLIC_KEY=
# Langfuse密钥
LANGFUSE_SECRET_KEY=
# Langfuse服务地址
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Langfuse环境标签
LANGFUSE_ENVIRONMENT=development
# 是否启用ZAP扫描
ZAP_ENABLED=false
# ZAP服务地址
ZAP_BASE_URL=
# 加密后的ZAP API密钥
ZAP_API_KEY_ENCRYPTED=
# ZAP密钥传递方式
ZAP_API_KEY_MODE=header
# 是否验证TLS证书
ZAP_VERIFY_TLS=true
# ZAP请求超时时长（秒）
ZAP_TIMEOUT_SECONDS=30.0
# 最大并发扫描任务数
ZAP_MAX_CONCURRENT_JOBS=1
# 扫描队列轮询间隔（秒）
ZAP_WORKER_POLL_INTERVAL_SECONDS=3.0
# 扫描任务心跳超时（秒）
ZAP_HEARTBEAT_TIMEOUT_SECONDS=180
# 单次扫描最长时长（秒）
ZAP_MAX_JOB_DURATION_SECONDS=7200
# 被动扫描等待时长（秒）
ZAP_PASSIVE_WAIT_SECONDS=300
# 单次扫描请求数上限
ZAP_REQUEST_BUDGET=5000

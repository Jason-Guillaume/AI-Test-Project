# 复制为 backend/.env 后按需修改。所有值都可以通过环境变量覆盖。
# 注意：CORS_ORIGINS 使用逗号分隔，不要写成 JSON 数组。

# PostgreSQL 连接串，格式：postgresql+psycopg://用户:密码@主机:端口/库名
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/testplatform_dev

# JWT 签名密钥：必须使用足够长的随机串，
# 例如 python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 允许跨域的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 主库连接池参数（可选）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# 仅初始化脚本使用：scripts/seed_admin.py 据此创建首个管理员账号。
# 刻意留空——本项目不内置任何固定管理员密码，请执行时用环境变量临时传入，
# 不要把真实凭据写进 .env 后提交到版本库：
#   INIT_ADMIN_USERNAME=admin INIT_ADMIN_PASSWORD='$(python -c "import secrets;print(secrets.token_urlsafe(18))")' \
#     .venv/bin/python scripts/seed_admin.py
INIT_ADMIN_USERNAME=
INIT_ADMIN_PASSWORD=

# 默认关闭。本地首次调试可临时开启，让应用在启动时自动建表；正式环境只用 Alembic
AUTO_CREATE_SCHEMA=false

# 内置环境地址，未配置时回退到示例域名
ENV_DEV_URL=http://127.0.0.1:8000
ENV_TEST_URL=http://test-api.example.com
ENV_STAGING_URL=http://staging-api.example.com
ENV_PROD_URL=

# ── Langfuse LLM 可观测（Agent 埋点，默认关闭）──
# 三环境隔离约定：每个环境一个独立的 Langfuse project（各一套 key），
# 真实 key 只写进对应环境的 .env / 部署平台环境变量，绝不提交到版本库。
# 在 https://cloud.langfuse.com 控制台按环境建 project：
#   · 开发环境 project  → 本机 .env，       LANGFUSE_ENVIRONMENT=development
#   · 测试环境 project  → 测试服部署变量，   LANGFUSE_ENVIRONMENT=test
#   · 生产环境 project  → 生产服部署变量，   LANGFUSE_ENVIRONMENT=production
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development

# ── Security Testing Phase 2：OWASP ZAP 安全扫描（默认关闭）──
# ZAP 必须以官方 owasp/zap2docker-stable 镜像在容器网络里启动，平台只通过
# Docker bridge 访问；ZAP 管理 API 绝不能对公网开放（不要把它映射到宿主端口）。
# 固定并记录镜像版本，见 docs/zap/README.md。
ZAP_ENABLED=false
# ZAP REST API 地址，例：http://127.0.0.1:8090（桥接网络内可达的地址）
ZAP_BASE_URL=
# API Key 只能存 Fernet 密文，禁止写明文。生成方式（密文与 SECRET_KEY 绑定）：
#   .venv/bin/python -c "from app.shared.crypto import encrypt_secret; print(encrypt_secret('你的ZAP-API-KEY'))"
ZAP_API_KEY_ENCRYPTED=
# API Key 传递方式：header（X-ZAP-API-Key）或 query（apikey=，不推荐）
ZAP_API_KEY_MODE=header
ZAP_VERIFY_TLS=true
ZAP_TIMEOUT_SECONDS=30.0
# 同一时刻最多执行的扫描任务数（第一版单 ZAP 实例建议保持 1）
ZAP_MAX_CONCURRENT_JOBS=1
ZAP_WORKER_POLL_INTERVAL_SECONDS=3.0
ZAP_HEARTBEAT_TIMEOUT_SECONDS=180
ZAP_MAX_JOB_DURATION_SECONDS=7200
ZAP_PASSIVE_WAIT_SECONDS=300
ZAP_REQUEST_BUDGET=5000
